# Modèle de configuration. Copie ce fichier en .env, ou laisse ./setup.sh le
# faire au premier lancement : il génère alors un ADMIN_TOKEN aléatoire.
#
# Après chaque modification : ./setup.sh puis ./start.sh, n8n arrêté entre les
# deux. Détail de chaque variable dans docs/configuration.md

# --- Sécurité -------------------------------------------------------------

# Jeton exigé par GET /webhook/contacts, dans l'en-tête X-Admin-Token.
# Pour le régénérer : openssl rand -hex 24
ADMIN_TOKEN=

# Origines autorisées à appeler les webhooks depuis un navigateur, séparées par
# des virgules et sans espace. L'origine comprend le protocole et le port.
# En local : http://localhost:8080
# En production : https://contact.mondomaine.com
ALLOWED_ORIGINS=http://localhost:8080

# --- Notifications Telegram (optionnel) -----------------------------------

# Les deux variables doivent être remplies, sinon le nœud Telegram reste
# désactivé et le workflow fonctionne sans lui.
# Jeton : crée un bot avec @BotFather.
# Chat ID : écris à @userinfobot, il renvoie ton identifiant numérique.
# Pense à envoyer un premier message à ton bot, sinon il ne peut pas t'écrire.
# Déclenchement : uniquement pour les messages de priorité haute.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notifications par email (optionnel, SMTP) ----------------------------

# SMTP_HOST, MAIL_FROM et MAIL_TO doivent être remplis, sinon le nœud Email
# reste désactivé. Déclenchement : à chaque message enregistré.
# Avec Gmail, utilise un mot de passe d'application, pas ton mot de passe.
# Port 587 avec SMTP_SECURE=false, ou port 465 avec SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=
MAIL_TO=

# --- Déploiement (voir docs/deploiement.md) -------------------------------

# Domaine public, dont l'enregistrement DNS pointe vers le serveur. Caddy y
# obtient un certificat HTTPS automatiquement.
DOMAIN=contact.exemple.com

# Clé de chiffrement des identifiants n8n. Générée au premier déploiement.
# À sauvegarder : sans elle, les identifiants enregistrés sont illisibles.
N8N_ENCRYPTION_KEY=

# Port local du serveur pour atteindre l'éditeur par tunnel SSH.
EDITOR_PORT=5678

# Ports publics. À modifier seulement pour un essai local de la pile Docker.
# HTTP_PORT=80
# HTTPS_PORT=443
