    {
      "id": "3b1f6c1e-0a01-4c1a-9f10-000000000002",
      "name": "Valider & Anti-spam",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "jsCode": "// Validation, piège à robots (honeypot) et limitation du débit.\n// Sortie : { action: 'store' | 'ignore' | 'reject', status, ... }\n\nconst MAX_PER_IP = 10; // messages par IP\nconst MAX_PER_EMAIL = 3; // messages par adresse email\nconst WINDOW_MS = 10 * 60 * 1000; // sur 10 minutes\n\nconst request = $input.first().json;\nconst body = request.body || {};\nconst headers = request.headers || {};\nconst now = Date.now();\n\nconst ip = String(headers['x-forwarded-for'] || headers['x-real-ip'] || 'local')\n  .split(',')[0]\n  .trim();\n\nconst name = String(body.name ?? '').trim();\nconst email = String(body.email ?? '').trim().toLowerCase();\nconst message = String(body.message ?? '').trim();\nconst honeypot = String(body.website ?? '').trim();\n\n// Champ caché rempli => robot. On répond 201 sans rien enregistrer.\nif (honeypot) {\n  return [{ json: { action: 'ignore', status: 201, response: { ok: true, id: 'ignored' } } }];\n}\n\nconst errors = [];\nif (name.length < 2) errors.push('name must be at least 2 characters');\nif (name.length > 100) errors.push('name must be at most 100 characters');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('email is not valid');\nif (email.length > 200) errors.push('email must be at most 200 characters');\nif (message.length < 10) errors.push('message must be at least 10 characters');\nif (message.length > 2000) errors.push('message must be at most 2000 characters');\n\nif (errors.length > 0) {\n  return [{ json: { action: 'reject', status: 400, response: { ok: false, errors } } }];\n}\n\n// Limitation du débit : compteurs gardés dans les static data du workflow.\nconst store = $getWorkflowStaticData('global');\nconst hits = (store.hits || []).filter((h) => now - h.at < WINDOW_MS);\nconst fromIp = hits.filter((h) => h.ip === ip).length;\nconst fromEmail = hits.filter((h) => h.email === email).length;\n\nif (fromIp >= MAX_PER_IP || fromEmail >= MAX_PER_EMAIL) {\n  store.hits = hits;\n  return [\n    {\n      json: {\n        action: 'reject',\n        status: 429,\n        response: { ok: false, errors: ['too many messages, try again later'] },\n      },\n    },\n  ];\n}\n\nstore.hits = [...hits, { at: now, ip, email }].slice(-500);\n\nconst urgentWords = ['urgent', 'asap', 'down', 'broken', 'error', 'urgence', 'panne'];\nconst lower = message.toLowerCase();\nconst priority = urgentWords.some((w) => lower.includes(w)) ? 'high' : 'normal';\n\nreturn [{ json: { action: 'store', status: 201, name, email, message, priority } }];\n"
      }
    },
