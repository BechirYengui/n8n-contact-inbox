    {
      "id": "3b1f6c1e-0a01-4c1a-9f10-000000000014",
      "name": "Formater la liste",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400],
      "parameters": {
        "jsCode": "// Met en forme les lignes de la Data Table, avec filtre ?priority=high.\n// Tant qu'aucun message n'a été reçu, la table n'existe pas encore : on\n// renvoie simplement une liste vide.\nconst query = $('GET /contacts').first().json.query || {};\n\nlet rows = $input.all().map((item) => item.json).filter((row) => row && row.id !== undefined);\n\nif (query.priority) {\n  rows = rows.filter((row) => row.priority === query.priority);\n}\n\nconst submissions = rows.slice(0, 100).map((row) => ({\n  id: row.id,\n  name: row.name,\n  email: row.email,\n  message: row.message,\n  priority: row.priority,\n  receivedAt: row.createdAt,\n}));\n\nreturn [{ json: { count: submissions.length, submissions } }];\n"
      }
